# OpenAI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# Neo4j Database Configuration (Remote Neo4j Aura or Local Instance)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Security & Authentication
JWT_SECRET=super_secret_neo4j_jwt_key_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LangSmith Observability (Optional)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=inventory-neo4j-ai-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:3001"]
MAX_CYPHER_RECORDS=100
CYPHER_TIMEOUT_SECONDS=10
